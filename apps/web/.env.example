VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Never commit the service_role key to the repo.
# It lives only in Edge Function secrets.

# ─── IMPORTANT FOR PRODUCTION BUILDS ───────────────────────────────────────────
# Vite reads `.env.production` when running `vite build`. Without it, the build
# falls back to the localhost URL and sync will fail in production with a 520.
#
# Create apps/web/.env.production (already gitignored) with your real credentials:
#   VITE_SUPABASE_URL=https://your-project.supabase.co
#   VITE_SUPABASE_ANON_KEY=your-anon-key-here
#
# In GitHub Actions / CI, set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY as
# repository secrets (Settings → Secrets and variables → Actions).
# ────────────────────────────────────────────────────────────────────────────────
